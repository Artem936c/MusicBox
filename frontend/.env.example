# ---------------------------------------------------------------------------
# Переменные сборки Mini App (Vite). Скопируйте файл в frontend/.env
# и при необходимости измените значения. Все переменные, доступные в браузере,
# ОБЯЗАНЫ начинаться с префикса VITE_. Секретов здесь быть не должно.
# ---------------------------------------------------------------------------

# Базовый путь REST API. По умолчанию '/api' — фронтенд ходит на тот же хост,
# что и раздал статику (в dev-режиме запросы проксируются на http://localhost:8000).
# Пример для отдельного домена API: https://musicbox.example.com/api
VITE_API_BASE=/api

# Origin для абсолютных ссылок на потоковое аудио и обложки (streamUrl).
# Пусто — ссылки остаются относительными (рекомендуется).
# Заполняйте, только если статика фронтенда и backend живут на разных доменах,
# например: https://musicbox.example.com
VITE_API_ORIGIN=

# Строка initData для отладки ВНЕ Telegram (когда window.Telegram.WebApp недоступен).
# Работает в паре с DEV_MODE=true на backend; на проде оставляйте пустым.
# Значение можно скопировать из Telegram DevTools: window.Telegram.WebApp.initData
VITE_DEV_INIT_DATA=
