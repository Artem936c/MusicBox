# =============================================================================
# MusicBox — пример настроек. Скопируйте файл в .env и заполните значения:
#     cp .env.example .env        (Windows: copy .env.example .env)
# Файл .env содержит секреты и НЕ попадает в git (см. .gitignore).
# Значения без кавычек, комментарии — только на отдельных строках.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Обязательные настройки Telegram
# -----------------------------------------------------------------------------

# Токен бота от @BotFather (команда /newbot).
BOT_TOKEN=123456789:AAExampleTokenReplaceWithYourOwnValue

# ID приватного канала-хранилища, куда бот складывает аудиофайлы.
# Создайте приватный канал, добавьте бота администратором (право «Публикация сообщений»),
# перешлите любое сообщение из канала боту @getmyid_bot или @userinfobot.
# ID канала всегда начинается с -100.
STORAGE_CHANNEL_ID=-1001234567890

# Публичный HTTPS-адрес Mini App (кнопка «Открыть MusicBox» в боте).
# Тот же адрес указывается в @BotFather: /setmenubutton.
# Можно оставить пустым — тогда кнопка WebApp не показывается.
WEBAPP_URL=https://example.com

# Секретный ключ для подписи временных ссылок на аудио.
# Сгенерируйте свой: python -c "import secrets; print(secrets.token_hex(32))"
# Значение change-me запрещено вне режима разработки.
SECRET_KEY=change-me

# -----------------------------------------------------------------------------
# 2. Хранилище данных и веб-сервер
# -----------------------------------------------------------------------------

# Путь к файлу базы SQLite (каталог создаётся автоматически).
DATABASE_PATH=data/musicbox.db

# Адрес и порт, на которых слушает веб-сервер.
API_HOST=0.0.0.0
API_PORT=8000

# -----------------------------------------------------------------------------
# 3. Режим работы бота
# -----------------------------------------------------------------------------

# polling — бот сам опрашивает Telegram (проще, подходит для VPS и локальной работы);
# webhook — Telegram сам шлёт обновления на ваш HTTPS-адрес (нужен домен и сертификат).
BOT_MODE=polling

# Только для BOT_MODE=webhook: публичный HTTPS-адрес сервера без завершающего слэша.
WEBHOOK_BASE_URL=

# Путь, по которому принимаются обновления от Telegram.
WEBHOOK_PATH=/telegram/webhook

# Секрет вебхука: Telegram присылает его в заголовке, посторонние запросы отбрасываются.
# Сгенерируйте: python -c "import secrets; print(secrets.token_urlsafe(32))"
WEBHOOK_SECRET=

# Базовый адрес Bot API. Меняйте только при использовании локального Bot API server
# (снимает ограничение в 20 МБ на скачивание файлов), например http://localhost:8081
TELEGRAM_API_BASE=https://api.telegram.org

# -----------------------------------------------------------------------------
# 4. Безопасность Mini App
# -----------------------------------------------------------------------------

# Срок годности initData от Telegram WebApp, секунды (86400 = сутки).
INIT_DATA_TTL=86400

# Срок годности ссылки на аудиопоток, секунды (21600 = 6 часов).
STREAM_TOKEN_TTL=21600

# Режим разработки: разрешает открывать Mini App в браузере без Telegram.
# В продакшене обязательно false.
DEV_MODE=false

# Telegram-ID пользователя, от имени которого работают запросы при DEV_MODE=true.
DEV_USER_ID=0

# Белый список Telegram-ID через запятую. Пусто = доступ открыт всем.
# Пример: 123456789,987654321
ALLOWED_USER_IDS=

# -----------------------------------------------------------------------------
# 5. Разделы статистики и пагинация
# -----------------------------------------------------------------------------

# «Часто прослушиваемые»: от скольких прослушиваний трек считается частым.
FREQUENT_THRESHOLD=10

# «Редко прослушиваемые»: диапазон числа прослушиваний (включительно).
RARE_MIN=1
RARE_MAX=5

# Сколько треков показывать в разделе «Самые часто прослушиваемые».
TOP_LIMIT=10

# Сколько треков показывать в разделе «Недавно добавленные».
RECENT_LIMIT=20

# Размер страницы в списках бота (кнопки «◀️ N/M ▶️»).
PAGE_SIZE=10

# Порог нечёткого поиска, 0–100. Меньше — больше результатов и «мусора».
FUZZY_THRESHOLD=60

# Максимальный размер скачиваемого файла в байтах.
# 20971520 = 20 МБ — жёсткий лимит Bot API; больше только с локальным Bot API server.
MAX_DOWNLOAD_SIZE=20971520

# -----------------------------------------------------------------------------
# 6. Поиск аудио в Telegram (опционально, нужен Telethon)
# -----------------------------------------------------------------------------

# true — включить команду /tgsearch и вкладку поиска по Telegram в Mini App.
# При false пользователи просто пересылают аудио боту — это работает всегда.
TELEGRAM_SEARCH_ENABLED=false

# API_ID и API_HASH обычного (не бот-) аккаунта: https://my.telegram.org → API development tools.
TG_API_ID=0
TG_API_HASH=

# Строка сессии Telethon. Получить: python scripts/get_telethon_session.py
# ВНИМАНИЕ: строка равнозначна доступу к аккаунту — никому её не передавайте.
TG_SESSION_STRING=

# Каналы для поиска по умолчанию, через запятую (без @).
# Пример: musicchannel,best_music_archive
TG_SEARCH_CHATS=

# -----------------------------------------------------------------------------
# 7. Распознавание музыки (опционально, по умолчанию выключено)
# -----------------------------------------------------------------------------

# Сервис распознавания исполнителя и названия: audd, acrcloud или genius.
# Пусто = распознавание выключено: бот честно скажет, что функция не настроена,
# и в сеть не пойдёт. ВНИМАНИЕ: это заготовка (ТЗ п. 7) — код запросов написан,
# но на живых ключах не проверялся, формат ответов стоит сверить с документацией
# сервиса перед боевым включением.
RECOGNITION_PROVIDER=

# AudD (https://audd.io) — распознавание по фрагменту аудио.
# Токен из личного кабинета; нужен только при RECOGNITION_PROVIDER=audd.
AUDD_API_TOKEN=

# ACRCloud (https://console.acrcloud.com) — распознавание по фрагменту аудио.
# Нужны все три значения из проекта Audio & Video Recognition
# и только при RECOGNITION_PROVIDER=acrcloud.
# Пример хоста: identify-eu-west-1.acrcloud.com
ACRCLOUD_HOST=
ACRCLOUD_KEY=
ACRCLOUD_SECRET=

# Genius (https://genius.com/api-clients) — Client Access Token.
# Нужен только при RECOGNITION_PROVIDER=genius. Genius ищет ПО ТЕКСТУ
# (названию трека или имени исполнителя), распознавания по звуку у него нет.
GENIUS_ACCESS_TOKEN=

# -----------------------------------------------------------------------------
# 8. Логирование и статика
# -----------------------------------------------------------------------------

# Уровень логирования: DEBUG, INFO, WARNING, ERROR, CRITICAL.
LOG_LEVEL=INFO

# Файл лога с ротацией. Пусто = писать только в консоль.
LOG_FILE=

# Разрешённые источники CORS через запятую. * = разрешить всем.
# Пример: https://example.com,https://www.example.com
CORS_ORIGINS=*

# Каталог собранного фронтенда (npm run build в папке frontend).
FRONTEND_DIST=frontend/dist
